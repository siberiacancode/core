{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "paths": { "@/*": ["./*"] },
    "types": ["node"]
  },
  "include": ["src", "bin"],
  "exclude": ["node_modules", "dist"]
}
