{
  "name": "@siberiacancode/lefthook",
  "type": "module",
  "version": "1.0.2",
  "description": "lefthook config and shared git hooks",
  "author": {
    "name": "SIBERIA CAN CODE 🧊",
    "url": "https://github.com/siberiacancode"
  },
  "license": "MIT",
  "homepage": "https://github.com/siberiacancode/core",
  "repository": {
    "url": "https://github.com/siberiacancode/core"
  },
  "bugs": {
    "url": "https://github.com/siberiacancode/core/issues"
  },
  "keywords": [
    "lefthook",
    "git",
    "hooks",
    "lint staged"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./lefthook.yml": "./dist/lefthook.yml",
    "./hooks/*": "./dist/hooks/*"
  },
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.mjs",
  "types": "dist/esm/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "shx rm -rf dist && shx mkdir -p dist/hooks && shx cp lefthook.yml dist/lefthook.yml && shx cp -r src/hooks/. dist/hooks && shx chmod +x dist/hooks/*.sh",
    "lint": "eslint . --fix",
    "lint-inspector": "npx @eslint/config-inspector",
    "format": "prettier --write .",
    "pretty": "pnpm lint && pnpm format"
  },
  "peerDependencies": {
    "lefthook": "^2.1.10"
  },
  "dependencies": {
    "lefthook": "^2.1.10"
  },
  "devDependencies": {
    "@siberiacancode/eslint": "*",
    "@siberiacancode/prettier": "*",
    "shx": "0.4.0"
  }
}
