{
  "name": "@siberiacancode/autotest",
  "type": "module",
  "version": "1.0.0",
  "description": "Typed test cases and automation utilities",
  "author": {
    "name": "SIBERIA CAN CODE 🧊",
    "url": "https://github.com/siberiacancode"
  },
  "license": "MIT",
  "homepage": "https://github.com/siberiacancode/core",
  "repository": {
    "url": "https://github.com/siberiacancode/core"
  },
  "bugs": {
    "url": "https://github.com/siberiacancode/core/issues"
  },
  "keywords": [
    "autotest",
    "test-case",
    "playwright",
    "e2e",
    "codegen"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.mjs",
  "types": "dist/esm/index.d.mts",
  "bin": {
    "autotest": "dist/bin/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "pnpm type && pnpm build",
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "eslint . --fix",
    "lint-inspector": "npx @eslint/config-inspector",
    "type": "tsc --noEmit",
    "format": "prettier --write .",
    "pretty": "pnpm type && pnpm lint && pnpm format",
    "unit-test": "vitest run"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.45.0",
    "mock-config-server": ">=5.0.0-beta.6 <6"
  },
  "dependencies": {
    "@siberiacancode/playwright": "workspace:^",
    "picocolors": "^1.1.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@siberiacancode/eslint": "2.18.1",
    "@siberiacancode/prettier": "1.9.0",
    "@siberiacancode/tsconfig": "1.2.0",
    "@siberiacancode/vitest": "2.5.0",
    "@types/node": "^26.2.0",
    "@types/yargs": "^17.0.35",
    "mock-config-server": "5.0.0-beta.6"
  }
}
