{
  "name": "@siberiacancode/apicraft",
  "type": "module",
  "version": "1.12.0",
  "description": "Generate rest api for your api with one command",
  "author": {
    "name": "SIBERIA CAN CODE 🧊",
    "url": "https://github.com/siberiacancode"
  },
  "license": "MIT",
  "homepage": "https://github.com/siberiacancode/core",
  "repository": {
    "url": "https://github.com/siberiacancode/core"
  },
  "bugs": {
    "url": "https://github.com/siberiacancode/core/issues"
  },
  "keywords": [
    "api",
    "typegen",
    "requests",
    "hooks"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.mjs",
  "types": "dist/esm/index.d.mts",
  "bin": {
    "apicraft": "dist/bin/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "pnpm build",
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "eslint . --fix",
    "lint-inspector": "npx @eslint/config-inspector",
    "type": "tsc --noEmit",
    "format": "prettier --write .",
    "pretty": "pnpm type && pnpm lint && pnpm format",
    "e2e-test": "pnpm build && vitest -c tests/vitest.config.ts"
  },
  "peerDependencies": {
    "@faker-js/faker": "^10",
    "@siberiacancode/fetches": "^1",
    "@tanstack/react-query": "^5",
    "axios": "^1",
    "ofetch": "^1 || ^2"
  },
  "dependencies": {
    "@antfu/install-pkg": "^2.0.1",
    "@clack/prompts": "^1.7.0",
    "@hey-api/openapi-ts": "0.82.5",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "cosmiconfig": "^9.0.1",
    "local-pkg": "^1.1.2",
    "typescript": "^5.9.3",
    "yargs": "^18.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@siberiacancode/eslint": "2.18.1",
    "@siberiacancode/fetches": "^1.14.1",
    "@siberiacancode/prettier": "1.9.0",
    "@siberiacancode/tsconfig": "1.2.0",
    "@siberiacancode/vitest": "2.5.0",
    "@tanstack/react-query": "^5.101.4",
    "@types/node": "^26.2.0",
    "@types/yargs": "^17.0.35",
    "axios": "^1.19.0",
    "ofetch": "^1.5.1"
  }
}
