{
  "name": "@siberiacancode/testids",
  "type": "module",
  "version": "1.0.0",
  "description": "Generate, validate and audit data-testid constants from a single yaml schema",
  "author": {
    "name": "SIBERIA CAN CODE 🧊",
    "url": "https://github.com/siberiacancode"
  },
  "license": "MIT",
  "homepage": "https://github.com/siberiacancode/core",
  "repository": {
    "url": "https://github.com/siberiacancode/core"
  },
  "bugs": {
    "url": "https://github.com/siberiacancode/core/issues"
  },
  "keywords": [
    "testid",
    "data-testid",
    "playwright",
    "e2e",
    "codegen",
    "vite-plugin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/esm/vite/index.d.mts",
        "default": "./dist/esm/vite/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/vite/index.d.cts",
        "default": "./dist/cjs/vite/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.mjs",
  "types": "dist/esm/index.d.mts",
  "bin": {
    "testids": "dist/bin/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "pnpm type && pnpm build",
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "eslint . --fix",
    "lint-inspector": "npx @eslint/config-inspector",
    "type": "tsc --noEmit",
    "format": "prettier --write .",
    "pretty": "pnpm type && pnpm lint && pnpm format",
    "unit-test": "vitest run"
  },
  "peerDependencies": {
    "vite": "^8"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "magic-string": "^1.2.0",
    "oxc-parser": "^0.144.0",
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.9.0",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@siberiacancode/eslint": "2.18.1",
    "@siberiacancode/prettier": "1.9.0",
    "@siberiacancode/tsconfig": "1.2.0",
    "@siberiacancode/vitest": "2.5.0",
    "@types/node": "^26.2.0",
    "@types/yargs": "^17.0.35",
    "vite": "^8.2.1"
  }
}
